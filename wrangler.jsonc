{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuttercat-android",
  "account_id": "d1de0620ae30b70e74ab76380cc6314b",
  "workers_dev": true,
  "vars": {
    "PUBLIC_APP_URL": "https://shuttercat-android.l1330720739.workers.dev",
    "AUTH_FROM_EMAIL": "ShutterCat <persicajane@gmail.com>"
  },
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "AUTH_DB", "database_name": "shuttercat-auth", "database_id": "6212c942-22f7-44e1-b085-4f05f17818ba" }],
  "durable_objects": {
    "bindings": [{ "name": "MEOW_USERS", "class_name": "MeowUser" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MeowUser"] }]
}
