{
  "name": "shuttercat-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test": "tsx --test tests/domain.test.ts tests/billing.test.ts && node --test --test-force-exit tests/auth.test.mjs tests/bedtime.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20260916.0-alpha",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "wrangler": "^4.0.0"
  }
}
